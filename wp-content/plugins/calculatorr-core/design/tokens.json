{
  "meta": {
    "name": "calculatorr design tokens",
    "version": "1.0.0",
    "themes": [
      "dark",
      "light"
    ],
    "defaultTheme": "dark"
  },
  "color": {
    "bg-page": {
      "dark": "#111418",
      "light": "#f7f6f3",
      "usage": "Page background below the header and hero; also the fill of text inputs"
    },
    "bg-raised": {
      "dark": "#14181d",
      "light": "#ffffff",
      "usage": "Header bar, homepage hero band, category page header band"
    },
    "bg-footer": {
      "dark": "#0d1013",
      "light": "#efede8",
      "usage": "Footer band"
    },
    "surface-card": {
      "dark": "#181c22",
      "light": "#ffffff",
      "usage": "Cards, panels, sidebar, calculator card, hero preview card"
    },
    "surface-sunken": {
      "dark": "#1c2128",
      "light": "#f1efeb",
      "usage": "Chips, list rows, secondary buttons, icon buttons, hero mini value cells"
    },
    "surface-hover": {
      "dark": "#232932",
      "light": "#ebe8e2",
      "usage": "Hover fill for chips, list rows and secondary buttons"
    },
    "border-default": {
      "dark": "#262c34",
      "light": "#e6e3dd",
      "usage": "Card borders, thumbnail bottom rule, stat strip dividers"
    },
    "border-strong": {
      "dark": "#2f363f",
      "light": "#d6d2ca",
      "usage": "Inputs, search form, icon buttons, secondary buttons, hero preview card"
    },
    "border-divider": {
      "dark": "#22272e",
      "light": "#e9e6e0",
      "usage": "Header bottom rule, section rules, footer rules"
    },
    "border-hover": {
      "dark": "#3a424c",
      "light": "#c9c4ba",
      "usage": "Card border on hover"
    },
    "text-primary": {
      "dark": "#eef1f4",
      "light": "#15181c",
      "usage": "Headings, card titles, input values, primary copy"
    },
    "text-secondary": {
      "dark": "#b7c0c9",
      "light": "#3f474f",
      "usage": "Nav links, footer links, long-form paragraph copy"
    },
    "text-muted": {
      "dark": "#9ea7b1",
      "light": "#535b64",
      "usage": "Lead paragraphs, card descriptions, stat captions"
    },
    "text-subtle": {
      "dark": "#8a949e",
      "light": "#656d76",
      "usage": "Breadcrumb separators, captions, input affixes, meta text"
    },
    "brand": {
      "dark": "#4fb8a5",
      "light": "#0f6b5e",
      "usage": "Icon tiles, primary buttons, links, active nav, accent text, chart principal"
    },
    "brand-hover": {
      "dark": "#7fd3c2",
      "light": "#0c5a4f",
      "usage": "Link hover"
    },
    "brand-soft-text": {
      "dark": "#7fd3c2",
      "light": "#0f6b5e",
      "usage": "Text on brand tints: eyebrow pill, result panel label"
    },
    "on-brand": {
      "dark": "#0d1714",
      "light": "#ffffff",
      "usage": "Text on primary buttons"
    },
    "tile-glyph": {
      "dark": "#13171c",
      "light": "#ffffff",
      "usage": "Icon stroke and logo bars on a brand tile"
    },
    "brand-graphic": {
      "dark": "#4fb8a5",
      "light": "#2a9d88",
      "usage": "Thumbnail motif strokes and fills (decorative only)"
    },
    "brand-tint": {
      "dark": "rgba(79,184,165,0.10)",
      "light": "rgba(15,107,94,0.07)",
      "usage": "Thumbnail backgrounds, eyebrow pill fill, hero result block fill"
    },
    "brand-tint-border": {
      "dark": "rgba(79,184,165,0.24)",
      "light": "rgba(15,107,94,0.2)",
      "usage": "Border around tinted blocks"
    },
    "accent": {
      "dark": "#e8a33a",
      "light": "#e8a33a",
      "usage": "The answer dot: one highlight per graphic, eyebrow dot, interest share in charts, notice icon"
    },
    "on-accent": {
      "dark": "#14171c",
      "light": "#14171c",
      "usage": "Text or icons placed on the amber accent"
    },
    "result-bg": {
      "dark": "#152320",
      "light": "#eef7f5",
      "usage": "Calculator result panel"
    },
    "result-border": {
      "dark": "#244039",
      "light": "#cfe6e0",
      "usage": "Result panel border and row dividers"
    },
    "result-muted": {
      "dark": "#9fbab3",
      "light": "#4d6660",
      "usage": "Secondary text inside the result panel"
    },
    "notice-bg": {
      "dark": "#231d12",
      "light": "#fdf3e1",
      "usage": "Disclaimer notice"
    },
    "notice-border": {
      "dark": "#4a3a1c",
      "light": "#f0d9a8",
      "usage": "Disclaimer notice border"
    },
    "notice-text": {
      "dark": "#e9cf9f",
      "light": "#6b4a10",
      "usage": "Disclaimer notice text"
    },
    "focus-ring": {
      "dark": "rgba(79,184,165,0.22)",
      "light": "rgba(15,107,94,0.18)",
      "usage": "3px spread ring on focused fields, paired with a brand border"
    },
    "shadow-float": {
      "dark": "0 30px 60px rgba(0,0,0,0.35)",
      "light": "0 30px 60px rgba(20,24,28,0.10)",
      "usage": "Hero preview card"
    },
    "shadow-chip": {
      "dark": "0 16px 32px rgba(0,0,0,0.3)",
      "light": "0 16px 32px rgba(20,24,28,0.14)",
      "usage": "Floating hero chips and tile"
    }
  },
  "font": {
    "display": {
      "family": "'Space Grotesk', system-ui, sans-serif",
      "weights": [
        500,
        600,
        700
